{
  "presets": {
    "defaults": [
      { "arg": "threads", "vals": ["1"] },
      { "arg": "iterations", "vals": ["0"] },
      { "arg": "deadline", "vals": ["300"] }
    ]
  },
  "validations": {
    "prepared_thread_variant": {
      "description": "an installed CoreMark thread-count variant (1 or 2)",
      "args": ["threads"],
      "vals": "^(1|2)$"
    },
    "iterations_or_auto": {
      "description": "0 for upstream automatic calibration or a positive native iteration count",
      "args": ["iterations"],
      "vals": "^(0|[1-9][0-9]{0,8}|1[0-9]{9}|20[0-9]{8}|21[0-3][0-9]{7}|214[0-6][0-9]{6}|2147[0-3][0-9]{5}|21474[0-7][0-9]{4}|214748[0-2][0-9]{3}|2147483[0-5][0-9]{2}|21474836[0-3][0-9]|214748364[0-7])$"
    },
    "deadline_per_mode": {
      "description": "a per-mode watchdog from 30 through 3600 seconds",
      "args": ["deadline"],
      "vals": "^(3[0-9]|[4-9][0-9]|[1-9][0-9]{2}|[1-2][0-9]{3}|3[0-5][0-9]{2}|3600)$"
    }
  }
}
